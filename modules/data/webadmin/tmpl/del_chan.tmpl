<? I18N znc-webadmin ?>
<? INC Header.tmpl ?>

<div class="section">
	<h3><? FORMAT "Confirm Channel Deletion" ?></h3>
	<div class="sectionbg">
		<div class="sectionbody">
			<div class="subsection">
				<? FORMAT "Are you sure you want to delete channel “{3}” of network “{2}” of user “{1}”?" Username Network Channel ?>
				<form action="<? VAR URIPrefix TOP ?><? VAR ModPath TOP ?>delchan" method="post">
					<? INC _csrf_check.tmpl ?>
					<input type="hidden" name="user" value="<? VAR Username ?>" />
					<input type="hidden" name="network" value="<? VAR Network ?>" />
					<input type="hidden" name="name" value="<? VAR Channel ?>" />
					<div class="yesnobutton"><input type="submit" value="<? FORMAT "Yes" ?>"/></div>
				</form>
				<form action="<? VAR URIPrefix TOP ?><? VAR ModPath TOP ?>editnetwork" method="get">
					<input type="hidden" name="user" value="<? VAR Username ?>" />
					<input type="hidden" name="network" value="<? VAR Network ?>" />
					<div class="yesnobutton"><input type="submit" value="<? FORMAT "No" ?>"/></div>
				</form>
			</div>
		</div>
	</div>
</div>

<? INC Footer.tmpl ?>
